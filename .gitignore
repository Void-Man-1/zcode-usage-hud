# Build artifacts (attach to GitHub Releases instead of tracking)
ZCode-Usage-HUD.exe
*.exe
*.exe~

# Versioned release folders (installers are attached to GitHub Releases,
# not tracked; see RELEASES.md)
releases/

# Local dev harness captures (see scripts/dev/)
scripts/dev/captures/

# Local captures from development/testing — may contain real account data
*.png
*.jpg

# Local logs and runtime state (all runtime data lives in
# %LOCALAPPDATA%\ZCode Usage HUD, never inside the repo)
*.log

# Security-scanner local state
.mimosa/

# Python development artifacts
__pycache__/
*.py[cod]

# Graph analysis scratch files
.graphify_*.json
graphify-out/
